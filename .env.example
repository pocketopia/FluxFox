# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Project Credentials for FluxFox Next.js 14 App
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# Google OAuth Client Credentials for the FluxFox Calendar Pipeline.
# Used server-side only (src/lib/google.ts) to exchange a user's stored
# refresh token for a live Google Calendar API client. Never expose these
# with a NEXT_PUBLIC_ prefix.
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# Vapi.ai Private API Key for the FluxFox Blueprint Orchestrator.
# Used server-side only (src/lib/vapi.ts) to create AI receptionist
# assistants via https://api.vapi.ai/assistant. Never expose this with a
# NEXT_PUBLIC_ prefix or return it in any API response.
VAPI_PRIVATE_API_KEY="your-vapi-private-api-key"

# Supabase Service Role Key for the FluxFox Master Webhook Router.
# Used server-side only (src/app/api/webhook/vapi/route.ts and
# src/app/api/stripe/webhook/route.ts) to authenticate server-to-server
# requests from Vapi/Stripe (no user cookies/session exist) and bypass Row
# Level Security when looking up a user by vapi_assistant_id or email.
# Never expose this with a NEXT_PUBLIC_ prefix or return it in any API response.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Stripe Publishable Key for client-side Stripe.js usage.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_or_test_your-publishable-key"

# Stripe Secret Key for the FluxFox Subscription Paywall.
# Used server-side only (src/lib/stripe.ts) to create Checkout Sessions and
# verify webhook events. Never expose this with a NEXT_PUBLIC_ prefix.
STRIPE_SECRET_KEY="your-stripe-secret-key"

# Stripe Price ids for the FluxFox monthly/annual subscription plans
# (created in the Stripe Dashboard under Products). Used by
# /api/stripe/checkout to build the Checkout Session line item.
NEXT_PUBLIC_STRIPE_MONTHLY_PRICE_ID="your-stripe-monthly-price-id"
NEXT_PUBLIC_STRIPE_ANNUAL_PRICE_ID="your-stripe-annual-price-id"

# Stripe Webhook Signing Secret ("whsec_...") for verifying inbound events
# at /api/stripe/webhook. Never expose this with a NEXT_PUBLIC_ prefix.
STRIPE_WEBHOOK_SECRET="your-stripe-webhook-signing-secret"

